{
	"info": {
		"name": "Taller Mecánico - Data de Prueba",
		"description": "Colección para crear data de prueba en orden de dependencias.\n\nFlujo:\n1. Ejecutar Sign Up + Sign In (el token se guarda automáticamente)\n2. Ejecutar las carpetas en orden numérico\n\nTodos los endpoints protegidos usan el token del Sign In automáticamente.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api"
		},
		{
			"key": "access_token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "0. Auth",
			"description": "Primero crear usuario y hacer login para obtener token.",
			"item": [
				{
					"name": "0.1 Sign Up (admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    console.log('Token guardado automáticamente');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\",\n    \"role\": \"ROLE_ADMIN\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/sign-up",
							"host": ["{{base_url}}"],
							"path": ["auth", "sign-up"]
						}
					}
				},
				{
					"name": "0.2 Sign In (admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    console.log('Token guardado: ' + jsonData.access_token.substring(0, 20) + '...');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "admin" },
								{ "key": "password", "value": "admin123" }
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/sign-in",
							"host": ["{{base_url}}"],
							"path": ["auth", "sign-in"]
						}
					}
				}
			]
		},
